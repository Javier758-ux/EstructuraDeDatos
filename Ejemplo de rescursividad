void fc()
{
    int num;
    cout << "Ingrese el numero a calcular: " << endl;
    cin >> num;
    cout << "El factorial de " << num << " es: " << factorial(num);
}
int factorial(int n) {
    if ((n == 0 || n == 1))
        return 1;
    else
        return factorial(n - 1) * n;
}
void ej6() {
    double x;
    int y;
    cout << "Ingrese el valor de X: ";
    cin >> x;
    cout << "Ingrese el valor de y: ";
    cin >> y;
    double resultado = serie(x, y);
    cout << "La suma de la serie es: " << resultado;
}
double serie(double x, int y)
{
    if (y == 0)
        return 0;
    else
        return x * (1 + serie(x, y - 1));
}
void comp()
{
    int r;
    cout << "Cuantos nùmeros enetos desea multiplicar? " << endl;
    cin >> r;
    if (r < 0)
        cout << "Por favor, ingrese un nùmero positivo" << endl;
    else
        cout << "El producto de los nùmero enteros es: " << producto(r)<<endl;
}
int producto(int r)
{
    if (r <= 1) {
        return 1;
    }
    else
        return r * producto(r - 1);
}

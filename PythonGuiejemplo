import tkinter as tk

def mostrar_datos():
    nombre = entrada_nombre.get()
    materia = entrada_materia.get()

    resultado.config(text="Estudiante: " + nombre + "\nMateria favorita: " + materia)

# Crear ventana principal
ventana = tk.Tk()
ventana.title("Registro de Estudiante")
ventana.geometry("350x250")

# Etiqueta principal
titulo = tk.Label(ventana, text="Formulario de Estudiante")
titulo.pack(pady=10)

# Entrada del nombre
label_nombre = tk.Label(ventana, text="Ingrese su nombre:")
label_nombre.pack()

entrada_nombre = tk.Entry(ventana)
entrada_nombre.pack()

# Entrada de materia
label_materia = tk.Label(ventana, text="Ingrese su materia favorita:")
label_materia.pack()

entrada_materia = tk.Entry(ventana)
entrada_materia.pack()

# Botón
boton = tk.Button(ventana, text="Mostrar datos", command=mostrar_datos)
boton.pack(pady=10)

# Resultado
resultado = tk.Label(ventana, text="")
resultado.pack()

# Ejecutar ventana
ventana.mainloop()

#include <iostream>
#include <string>
using namespace std;

int valor(char c);
int potencia(int base,int exp);
int baseADecimal(string numero,int base,int indice);

int main(){
    string numero;
    int base;
    cout<<"Ingrese el numero: ";
    cin>>numero;
    cout<<"Ingrese la base: ";
    cin>>base;
    int resultado=baseADecimal(numero,base,0);
    if(resultado==-1) cout<<"Error: numero invalido para esa base."<<endl;
    else cout<<"En decimal es: "<<resultado<<endl;
    return 0;
}

int valor(char c){
    if(c>='0' && c<='9') return c-'0';
    if(c>='A' && c<='Z') return c-'A'+10;
    if(c>='a' && c<='z') return c-'a'+10;
    return -1;
}

int potencia(int base,int exp){
    if(exp==0) return 1;
    return base*potencia(base,exp-1);
}

int baseADecimal(string numero,int base,int indice){
    if(indice==numero.length()) return 0;
    int digito=valor(numero[indice]);
    if(digito==-1 || digito>=base) return -1;
    int resto=baseADecimal(numero,base,indice+1);
    if(resto==-1) return -1;
    return digito*potencia(base,numero.length()-indice-1)+resto;
}

//tringulo.h
#pragma once

class Triangulo
{
private:
    float base;
    float altura;
    float area;

public:
    Triangulo();
    ~Triangulo();

    float calculararea(float b, float h);
};
//triangulo.cpp
#include "Triangulo.h"

Triangulo::Triangulo()
{
    base = 4;
    altura = 3;
    area = 0;
}

Triangulo::~Triangulo()
{
}

float Triangulo::calculararea(float b, float h)
{
    base = b;
    altura = h;
    area = (base * altura) / 2;
    return area;
}

import tkinter as tk
from tkinter import messagebox


# ------------------ FUNCIONES ------------------

def convertir_numero(campo):
    texto = campo.get().strip().replace(",", ".")

    if texto == "":
        raise ValueError

    return float(texto)


def validar_datos():
    monto = convertir_numero(entry_monto)
    compra_usdt_bs = convertir_numero(entry_compra_usdt_bs)
    venta_usdt_soles = convertir_numero(entry_venta_usdt_soles)
    porcentaje_comision = convertir_numero(entry_comision)

    if monto <= 0:
        messagebox.showerror("Error", "El monto debe ser mayor a 0.")
        return None

    if compra_usdt_bs <= 0:
        messagebox.showerror("Error", "El precio de compra del USDT debe ser mayor a 0.")
        return None

    if venta_usdt_soles <= 0:
        messagebox.showerror("Error", "El precio de venta del USDT debe ser mayor a 0.")
        return None

    if porcentaje_comision < 0:
        messagebox.showerror("Error", "La comisión no puede ser negativa.")
        return None

    return monto, compra_usdt_bs, venta_usdt_soles, porcentaje_comision


def mostrar_resultado(texto):
    resultado_text.config(state="normal")
    resultado_text.delete("1.0", tk.END)
    resultado_text.insert(tk.END, texto)
    resultado_text.config(state="disabled")


def bolivianos_a_soles():
    try:
        datos = validar_datos()

        if datos is None:
            return

        bolivianos, compra_usdt_bs, venta_usdt_soles, porcentaje_comision = datos

        usdt = bolivianos / compra_usdt_bs
        soles = usdt * venta_usdt_soles

        monto_comision = bolivianos * (porcentaje_comision / 100)
        total_deposito = bolivianos + monto_comision

        texto = (
            f"🇧🇴 Conversión de Bolivianos a Soles 🇵🇪\n\n"
            f"Con Bs {bolivianos:.2f} puedes recibir:\n"
            f"💵 {usdt:.4f} USDT\n"
            f"💰 S/ {soles:.2f}\n\n"
            f"📊 Comisión: {porcentaje_comision:.2f}% = Bs {monto_comision:.2f}\n"
            f"✅ Total a depositar: Bs {total_deposito:.2f}"
        )

        mostrar_resultado(texto)

    except ValueError:
        messagebox.showerror("Error", "Ingrese solo números válidos.")


def soles_a_bolivianos():
    try:
        datos = validar_datos()

        if datos is None:
            return

        soles, compra_usdt_bs, venta_usdt_soles, porcentaje_comision = datos

        usdt = soles / venta_usdt_soles
        bolivianos = usdt * compra_usdt_bs

        monto_comision = bolivianos * (porcentaje_comision / 100)
        total_deposito = bolivianos + monto_comision

        texto = (
            f"🇵🇪 Conversión de Soles a Bolivianos 🇧🇴\n\n"
            f"Para recibir S/ {soles:.2f} necesitas:\n"
            f"💵 {usdt:.4f} USDT\n"
            f"💰 Depositar Bs {bolivianos:.2f}\n\n"
            f"📊 Comisión: {porcentaje_comision:.2f}% = Bs {monto_comision:.2f}\n"
            f"✅ Total a depositar: Bs {total_deposito:.2f}"
        )

        mostrar_resultado(texto)

    except ValueError:
        messagebox.showerror("Error", "Ingrese solo números válidos.")


def limpiar():
    entry_monto.delete(0, tk.END)
    entry_compra_usdt_bs.delete(0, tk.END)
    entry_venta_usdt_soles.delete(0, tk.END)
    entry_comision.delete(0, tk.END)

    mostrar_resultado("Resultado aparecerá aquí.")


def cambiar_color_boton(boton, color):
    boton.config(bg=color)


def crear_boton(padre, texto, color, color_hover, comando):
    boton = tk.Button(
        padre,
        text=texto,
        font=FUENTE_BOTON,
        bg=color,
        fg="white",
        activebackground=color_hover,
        activeforeground="white",
        relief="flat",
        cursor="hand2",
        command=comando
    )

    boton.bind("<Enter>", lambda e: cambiar_color_boton(boton, color_hover))
    boton.bind("<Leave>", lambda e: cambiar_color_boton(boton, color))

    return boton


def crear_campo(padre, texto):
    tk.Label(
        padre,
        text=texto,
        font=FUENTE_LABEL,
        bg=AZUL_CARD_2,
        fg="#cbd5e1"
    ).pack(anchor="w")

    entrada = tk.Entry(
        padre,
        font=FUENTE_ENTRY,
        justify="center",
        bg="#eef6ff",
        fg="#0f172a",
        insertbackground="#0f172a",
        relief="flat"
    )

    entrada.pack(fill="x", pady=(5, 13), ipady=7)

    return entrada



def potencia(base, exponente):
    if exponente == 0:
        return 1
    else:
        return base * potencia(base, exponente - 1)


def valor_digito(caracter):
    if '0' <= caracter <= '9':
        return ord(caracter) - ord('0')
    elif 'A' <= caracter <= 'Z':
        return ord(caracter) - ord('A') + 10
    elif 'a' <= caracter <= 'z':
        return ord(caracter) - ord('a') + 10
    else:
        return -1


def convertir_decimal(numero, base, posicion):
    if posicion == len(numero):
        return 0

    digito = valor_digito(numero[posicion])
    exponente = len(numero) - posicion - 1

    return digito * potencia(base, exponente) + convertir_decimal(numero, base, posicion + 1)


def factorial(num):
    if num == 0 or num == 1:
        return 1
    else:
        return num * factorial(num - 1)


def serie_exponencial(x, n):
    if n == 0:
        return 1
    else:
        return serie_exponencial(x, n - 1) + potencia(x, n) / factorial(n)


def suma_digitos(numero):
    if numero == 0:
        return 0
    else:
        return numero % 10 + suma_digitos(numero // 10)


